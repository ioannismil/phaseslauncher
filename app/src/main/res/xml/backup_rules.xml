<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 8-11, whose backup can't tell the cloud from a phone-to-phone transfer: nothing is
    backed up, so places, network names and app history never reach the cloud. See
    data_extraction_rules.xml for Android 12+.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
