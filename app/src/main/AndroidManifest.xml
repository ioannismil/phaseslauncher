<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets "Uninstall" open the system uninstall confirmation. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Swipe down on home pulls down the notification shade. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Lets the default launcher see Android 15's Private Space. -->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />
    <!-- Per-theme wallpaper. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Per-theme Do Not Disturb (the user grants access in Settings). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Contacts in drawer search (asked at runtime, optional). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Switch theme when a chosen Bluetooth device (e.g. the car) connects (asked at runtime, optional). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- Switch theme on a chosen Wi-Fi network; Android only reveals network names with location access (asked at runtime, optional). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Place rules while another app is open ("Allow all the time"; asked separately, optional). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Switch theme during calendar events (asked at runtime, optional). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Daily limits per theme: how long apps were used today (granted in Settings, optional). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Package visibility (Android 11+): see every app that has a launcher entry. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Icon packs (ADW / Nova / Apex / GO formats). -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="com.gau.go.launcherex.theme" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.anddoes.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.teslacoilsw.launcher.THEME" />
        </intent>
        <!-- Web-search fallback in the drawer. -->
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
    </queries>

    <application
        android:name=".PhasesApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Phases">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize|stateHidden">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Also listed in the app list so it can be opened before it is the default home. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Add to home screen" from other apps: asks which theme the shortcut or widget goes on. -->
        <activity
            android:name=".ui.pin.PinItemActivity"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Phases.PinItem">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_APPWIDGET" />
            </intent-filter>
        </activity>

        <!-- Shared themes: a phases:// link (e.g. from a QR code), a theme file, or text with a link. -->
        <activity
            android:name=".ui.share.ImportThemeActivity"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Phases.PinItem">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="phases" android:host="phase" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <!-- Switching phases from other apps (see api/PhaseApi.kt). The broadcast is for Tasker and the
             like and works only while the user allows it in settings; the activity backs the "Switch to"
             app shortcuts and phases://switch links, for apps that open shortcuts or activities. -->
        <!-- No permission on purpose: Tasker and the like can't hold one; the setting guards it instead. -->
        <receiver
            android:name=".api.SwitchPhaseReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.phaseslauncher.action.SWITCH_PHASE" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".api.SwitchPhaseActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="phases" android:host="switch" />
            </intent-filter>
        </activity>

        <!-- Theme files handed to the share sheet. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <!-- Quick Settings tile: shows the active theme and switches themes from the shade. -->
        <service
            android:name=".ui.tile.ThemeTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_theme"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Wakes the launcher when a scheduled theme should start or end. -->
        <receiver
            android:name=".data.rules.ScheduleAlarmReceiver"
            android:exported="false" />

        <!-- Double-tap to lock. Off unless the user turns it on in Accessibility settings. -->
        <service
            android:name=".data.system.LockScreenService"
            android:exported="true"
            android:label="@string/lock_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_service" />
        </service>

        <!-- Notification dots. Only active once the user grants notification access. -->
        <service
            android:name=".data.notifications.NotificationDotsService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
